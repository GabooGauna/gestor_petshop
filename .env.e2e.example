# URL and public key for the target Supabase project. Never point mutating E2E at production.
VITE_SUPABASE_URL=https://your-isolated-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
E2E_BASE_URL=http://localhost:5173

# Dedicated authenticated test user; never commit real credentials.
E2E_EMAIL=qa@example.invalid
E2E_PASSWORD=replace-me

# All three values are required before legacy/catalog mutation tests can run.
E2E_ISOLATED=true
E2E_MUTATIONS=isolated-only
E2E_RUN_ID=local-unique-run-id

# Optional custom browser executable (for example Brave on Windows).
# PLAYWRIGHT_BROWSER_PATH=C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe
